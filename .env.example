# Copy to .env. Development-only defaults; replace every secret for production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tablechat.local
CSRF_TRUSTED_ORIGINS=https://localhost,https://tablechat.local
POSTGRES_DB=tablechat
POSTGRES_USER=tablechat
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tablechat:change-me@db:5432/tablechat
# Pour Supabase, copier l'URI Session pooler (port 5432) et ajouter sslmode=require.
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
# Cache partagé des limitations de fréquence (peut pointer vers le même Redis).
CACHE_URL=redis://redis:6379/0
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
# Adresse réellement ouverte par les appareils (ex. https://192.168.1.42)
SITE_ADDRESS=https://localhost
SITE_HOST=localhost

# Emails locaux : Mailpit est visible uniquement sur http://localhost:8025.
APP_BASE_URL=https://localhost
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=TableChat <noreply@tablechat.local>
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800

# Sauvegardes locales (les scripts acceptent aussi des paramètres explicites).
BACKUP_DESTINATION=./backups
BACKUP_RETENTION_DAYS=14
