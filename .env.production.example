# Vercel / Django
DJANGO_SETTINGS_MODULE=tablechat.settings.production
DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.vercel.app,chat.example.com
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://chat.example.com

# Supabase PostgreSQL: use the Session pooler URI on port 5432.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_CONN_MAX_AGE=60

# Redis TCP/TLS, for example the rediss:// URI supplied by Upstash.
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379
CACHE_URL=rediss://default:PASSWORD@REDIS_HOST:6379

# Public application URL and secure cookies
APP_BASE_URL=https://chat.example.com
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Transactional email provider
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=TableChat <noreply@example.com>
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
